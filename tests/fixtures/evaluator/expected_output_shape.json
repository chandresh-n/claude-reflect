{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvaluatorOutput",
  "description": "Schema for the evaluator output report, derived from docs/spec/01-data-structures/evaluator-output.md",
  "type": "object",
  "required": ["per_turn_observations", "pass_classifications", "gap_observations", "session_narratives"],
  "additionalProperties": false,
  "properties": {
    "per_turn_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["session_id", "turn_index", "assessment", "effort_signal", "flags"],
        "additionalProperties": false,
        "properties": {
          "session_id": {"type": "string"},
          "turn_index": {"type": "integer", "minimum": 0},
          "assessment": {"type": "string", "minLength": 1},
          "effort_signal": {
            "type": "object",
            "required": ["tokens_used", "model", "context_occupancy", "tool_calls"],
            "additionalProperties": false,
            "properties": {
              "tokens_used": {"type": "integer", "minimum": 0},
              "model": {"type": "string"},
              "context_occupancy": {"type": "number", "minimum": 0, "maximum": 1},
              "tool_calls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["tool_name", "count"],
                  "additionalProperties": false,
                  "properties": {
                    "tool_name": {"type": "string"},
                    "count": {"type": "integer", "minimum": 1}
                  }
                }
              }
            }
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["flag_type"],
              "properties": {
                "flag_type": {"type": "string"},
                "description": {"type": "string"}
              }
            }
          },
          "tool_verifications": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["tool_name", "output"],
              "properties": {
                "tool_name": {"type": "string"},
                "output": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "pass_classifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["session_id", "turn_range", "pass_type", "harness_gap_rationale", "contributing_gaps"],
        "additionalProperties": false,
        "properties": {
          "session_id": {"type": "string"},
          "turn_range": {
            "type": "object",
            "required": ["start", "end"],
            "additionalProperties": false,
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 0}
            }
          },
          "pass_type": {
            "type": "string",
            "enum": ["successful_one_shot", "refinement", "clarification", "correction", "retry"]
          },
          "harness_gap_rationale": {"type": "string", "minLength": 1},
          "contributing_gaps": {
            "oneOf": [
              {"type": "null"},
              {"type": "array", "items": {"type": "string"}}
            ]
          }
        }
      }
    },
    "gap_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["matched_gap_id", "characterization", "kind", "evidence_additions"],
        "additionalProperties": false,
        "properties": {
          "matched_gap_id": {
            "oneOf": [
              {"type": "null"},
              {"type": "string"}
            ]
          },
          "characterization": {
            "oneOf": [
              {"type": "null"},
              {"type": "string"}
            ]
          },
          "kind": {"type": "string", "minLength": 1},
          "evidence_additions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["session_id", "turn_range", "magnitude"],
              "additionalProperties": false,
              "properties": {
                "session_id": {"type": "string"},
                "turn_range": {
                  "type": "object",
                  "required": ["start", "end"],
                  "additionalProperties": false,
                  "properties": {
                    "start": {"type": "integer", "minimum": 0},
                    "end": {"type": "integer", "minimum": 0}
                  }
                },
                "magnitude": {
                  "type": "object",
                  "required": ["additional_turns", "additional_tokens", "correction_required"],
                  "properties": {
                    "additional_turns": {"type": "integer", "minimum": 0},
                    "additional_tokens": {"type": "integer", "minimum": 0},
                    "correction_required": {"type": "boolean"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "session_narratives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["session_id", "outcome", "pass_counts_by_type", "gaps_observed", "narrative"],
        "additionalProperties": false,
        "properties": {
          "session_id": {"type": "string"},
          "outcome": {
            "type": "string",
            "enum": ["successful_and_accepted", "successful_with_friction", "abandoned", "ongoing"]
          },
          "pass_counts_by_type": {
            "type": "object",
            "additionalProperties": {"type": "integer", "minimum": 0}
          },
          "gaps_observed": {
            "type": "array",
            "items": {"type": "string"}
          },
          "narrative": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
